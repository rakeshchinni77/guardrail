# GuardRail Environment Configuration Template
# Copy this file to .env for local development. Never commit .env with real credentials.

# Application Configuration
APP_NAME=GuardRail
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Run Ledger (for Phase 2+)
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# Celesto Cloud Sandbox Execution (for Phase 3+)
CELESTO_API_KEY=replace_with_your_celesto_api_key
CELESTO_TIMEOUT_SECONDS=60

# Optional LLM Provider Configuration (for Phase 4+)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace_with_your_llm_api_key
