# GuardRail Environment Configuration Template
# Copy this file to .env for local development. Never commit .env with real credentials.

# Application Configuration
APP_NAME=GuardRail
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8080

# PostgreSQL Run Ledger (Docker Compose internal: postgresql://ledger:ledger@ledger:5432/ledger)
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# Celesto Cloud Sandbox Execution (Phase 3+)
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
CELESTO_TIMEOUT_SECONDS=60

# Optional LLM Provider Configuration (Phase 4+)
LLM_BASE_URL=https://example-llm-host/v1
LLM_PROVIDER=openai
LLM_MODEL=replace-with-a-model-name
LLM_API_KEY=replace-me

# Evaluation & Containment Test Settings (Phase 5+)
POISONED_PAGE_BASE_URL=http://host.docker.internal:9000
EVIDENCE_COLLECTOR_URL=http://host.docker.internal:9001
CANARY_SECRET=replace-with-fake-canary
MAX_SANDBOX_RUNTIME_S=600
EVAL_RUN_COUNT=20
