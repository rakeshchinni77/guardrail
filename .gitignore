# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
.venv-linux/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment and Secrets (CRITICAL)
.env
*.env
!.env.example
*.pem
*.key
*.cert
*.crt

# Testing and Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Ruff and Linters
.ruff_cache/
.mypy_cache/

# IDE and Editor State
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Runtime logs and temporary artifacts
*.log
logs/*
!logs/.gitkeep

# Evaluation output artifacts (keep .gitkeep, ignore raw runs during dev)
reports/*
!reports/.gitkeep
fixtures/clean/*
!fixtures/clean/.gitkeep
fixtures/pages/*
!fixtures/pages/.gitkeep
scripts/*
!scripts/.gitkeep
evidence/*
!evidence/.gitkeep
!evidence/README.md
